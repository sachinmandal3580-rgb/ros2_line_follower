<?xml version="1.0" ?>
<sdf version="1.9">

<!--
======================================================================
 WHY SDF FOR THIS PROJECT
======================================================================

We use SDF instead of URDF because this project depends heavily on:

- realistic physics (slip, friction, inertia)
- sensor simulation (camera + IMU noise)
- plugin-based control (diff drive, joint states)
- tight coupling between simulation and ROS control loop

URDF only describes structure.
SDF describes structure + behavior + physics + sensors.

This matters because line-following performance is extremely sensitive
to simulation realism.
======================================================================
-->

  <model name="custom_turtlebot">
    <pose>0 0 0 0 0 0</pose>

    <!-- ========================================================= -->
    <!-- BASE LINK                                                 -->
    <!-- ========================================================= -->
    <link name="base_link">

      <collision name="base_collision">
        <geometry>
          <box>

            <!-- TODO 1: Base dimensions (VERY IMPORTANT)
            What to do:
            - Set real robot footprint size (length, width, height)

            Why it matters:
            - This affects inertia + collision + turning behavior
            - Wrong size → robot turns too easily or becomes unstable

            If wrong:
            - controller tuning (KP, speed) becomes meaningless
            -->
            <size>TODO: length width height</size>

          </box>
        </geometry>
      </collision>

    </link>

    <!-- ========================================================= -->
    <!-- IMU SENSOR                                                -->
    <!-- ========================================================= -->
    <link name="imu_link">

      <sensor name="imu" type="imu">
        <always_on>true</always_on>

        <!-- TODO 2: IMU update rate
        What to do:
        - Set how frequently IMU publishes data (Hz)

        Why it matters:
        - Higher rate → smoother orientation estimation
        - Lower rate → noisy / delayed motion perception

        Link to controller:
        - Must align with ROS control loop stability
        -->
        <update_rate>TODO</update_rate>

        <imu>

          <!-- TODO 3: IMU noise tuning (VERY IMPORTANT FOR ROBUSTNESS)
          What to do:
          - Set Gaussian noise stddev for angular velocity + acceleration

          Why it matters:
          - Real robots are noisy → controller must be robust
          - Too clean → unrealistic perfect tracking in sim
          - Too noisy → unstable drift and oscillation

          What students should observe:
          - increasing noise makes line follower “hunt” more
          -->
          <angular_velocity>
            <x><noise><stddev>TODO</stddev></noise></x>
            <y><noise><stddev>TODO</stddev></noise></y>
            <z><noise><stddev>TODO</stddev></noise></z>
          </angular_velocity>

        </imu>
      </sensor>
    </link>

    <!-- ========================================================= -->
    <!-- WHEELS (CRITICAL FOR CONTROL BEHAVIOR)                    -->
    <!-- ========================================================= -->
    <link name="wheel_left_link">

      <!-- TODO 4: Wheel geometry
      What to do:
      - Set radius and thickness correctly

      Why it matters:
      - Directly affects speed conversion from cmd_vel
      - Wrong radius → robot moves faster/slower than expected

      Symptom of wrong value:
      - robot overshoots curves or never reaches marker
      -->
      <geometry>
        <cylinder>
          <radius>TODO</radius>
          <length>TODO</length>
        </cylinder>
      </geometry>

      <!-- TODO 5: Friction model (MOST IMPORTANT FOR LINE FOLLOWING)
      What to do:
      - Tune mu and mu2 (surface friction coefficients)

      Why it matters:
      - Controls grip between wheel and ground

      If too high:
      - robot feels “glued” → unrealistic sharp turns

      If too low:
      - robot slips → cannot follow line properly

      Real insight:
      - This directly affects stability of proportional control (KP)
      -->
      <surface>
        <friction>
          <mu>TODO</mu>
          <mu2>TODO</mu2>
        </friction>

        <!-- TODO 6: Contact stability tuning
        What to do:
        - Adjust solver stiffness (kp, kd, soft_erp)

        Why it matters:
        - Controls jitter on curves and collision response

        If wrong:
        - robot vibrates or shakes while turning
        -->
        <contact>
          <ode>
            <kp>TODO</kp>
            <kd>TODO</kd>
            <soft_erp>TODO</soft_erp>
          </ode>
        </contact>

      </surface>

    </link>

    <!-- ========================================================= -->
    <!-- CAMERA (MOST CRITICAL FOR PERCEPTION)                     -->
    <!-- ========================================================= -->
    <link name="camera_rgb_optical_frame">

      <sensor name="camera" type="camera">

        <!-- TODO 7: Camera update rate (CORE SYSTEM PARAMETER)
        What to do:
        - Set FPS of camera output

        Why it matters:
        - Must match ROS control loop (TIMER_PERIOD)
        - mismatch → lag → oscillations in steering

        Rule of thumb:
        camera rate >= 2x control loop rate
        -->
        <update_rate>TODO</update_rate>

        <camera>

          <!-- TODO 8: Field of View (FOV) tuning (VERY IMPORTANT)
          What to do:
          - Set horizontal FOV angle

          Why it matters:
          - Wide FOV → sees more environment but noisy detection
          - Narrow FOV → stable line but poor recovery when lost

          Behavior effect:
          - Affects how fast robot can re-find track
          -->
          <horizontal_fov>TODO</horizontal_fov>

          <!-- TODO 9: Camera noise realism
          What to do:
          - Add Gaussian noise stddev

          Why it matters:
          - Makes vision pipeline realistic (OpenCV thresholding etc.)
          - Without noise → “too perfect robot” problem

          Expected effect:
          - line centroid will jitter slightly
          -->
          <noise>
            <stddev>TODO</stddev>
          </noise>

        </camera>
      </sensor>
    </link>

    <!-- ========================================================= -->
    <!-- DIFF DRIVE CONTROLLER (CONTROL CORE)                      -->
    <!-- ========================================================= -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

      <!-- TODO 10: Wheel separation (CRITICAL CONTROL PARAM)
      What to do:
      - Set distance between left and right wheels

      Why it matters:
      - Directly affects turning radius

      If wrong:
      - robot over-rotates or under-rotates
      - KP tuning becomes impossible

      This is one of the MOST important tuning parameters
      -->
      <wheel_separation>TODO</wheel_separation>

      <!-- TODO 11: Wheel radius calibration
      What to do:
      - Must match actual wheel geometry

      Why it matters:
      - Converts angular velocity → linear motion

      If wrong:
      - speed mismatch between simulation and controller
      -->
      <wheel_radius>TODO</wheel_radius>

      <!-- TODO 12: Acceleration limit tuning
      What to do:
      - Set max linear acceleration

      Why it matters:
      - Prevents jerky motion
      - Smoothens control response

      If too high:
      - unstable oscillations in turns

      If too low:
      - sluggish robot that cannot recover from error
      -->
      <max_linear_acceleration>TODO</max_linear_acceleration>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

    </plugin>

  </model>
</sdf>